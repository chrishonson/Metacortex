{
  "version": 1,
  "gates": [
    {
      "id": "metacortex_typecheck",
      "placement": [
        "cloud-linux",
        "cloud-macos",
        "local"
      ],
      "commands": [
        "npm --prefix functions run build",
        "npm --prefix functions run typecheck:eval"
      ]
    },
    {
      "id": "metacortex_test",
      "placement": [
        "cloud-linux",
        "cloud-macos",
        "local"
      ],
      "commands": [
        "npm --prefix functions test"
      ]
    }
  ]
}
